# --- App ---
APP_NAME=concord
APP_ENV=dev
SECRET_KEY=change-me-in-prod-32-bytes-minimum
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Postgres ---
POSTGRES_USER=concord
POSTGRES_PASSWORD=concord-dev-password
POSTGRES_DB=concord
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://concord:concord-dev-password@postgres:5432/concord

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Sandbox ---
SANDBOX_IMAGE=concord-sandbox:latest
SANDBOX_MEM_LIMIT=128m
SANDBOX_CPU_QUOTA=50000   # 0.5 CPU in microseconds per 100ms
SANDBOX_PIDS_LIMIT=64
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_NETWORK=none

# --- Worker ---
WORKER_CONCURRENCY=2

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
